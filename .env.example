# Required
GROQ_API_KEY=
# Postgres: LangGraph checkpoints (interview sessions) and resume templates
DATABASE_URL=postgresql://user:password@localhost:5432/career_advisor

# Optional: features degrade gracefully without these
COHERE_API_KEY=        # reranks job postings and interview questions
TAVILY_API_KEY=        # web search for new courses
GITHUB_ACCESS_TOKEN=   # higher GitHub API rate limits

# Optional overrides
# LLM_MODEL=llama-3.3-70b-versatile
# RESUME_LLM_MODEL=openai/gpt-oss-120b
# DATA_DIR=backend/data          # Chroma stores and generated files
# CORS_ORIGINS=["http://localhost:3000"]
