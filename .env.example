# Required
GROQ_API_KEY=
# Postgres: LangGraph checkpoints (interview sessions) and resume templates.
# Not needed with Docker Compose, which runs its own Postgres and sets this itself.
DATABASE_URL=postgresql://user:password@localhost:5432/career_advisor

# Optional: features degrade gracefully without these
COHERE_API_KEY=        # reranks job postings and interview questions
TAVILY_API_KEY=        # web search for new courses
GITHUB_ACCESS_TOKEN=   # higher GitHub API rate limits

# Optional overrides
# Models (defaults chosen by the evals in backend/evals/). Effort: low, medium, high, or
# none for models without reasoning.
# LLM_MODEL=openai/gpt-oss-120b
# LLM_REASONING_EFFORT=medium
# RESUME_LLM_MODEL=openai/gpt-oss-20b
# RESUME_LLM_REASONING_EFFORT=low
# DATA_DIR=backend/data          # Chroma stores and generated files
# CORS_ORIGINS=["http://localhost:3000"]

# Docker Compose only (defaults shown); the database is not reachable from outside Docker
# POSTGRES_PASSWORD=career
# PORT=3000                      # where the web app is served on your machine
